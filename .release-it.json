{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "push": true,
    "commit": true,
    "tag": true,
    "requireCleanWorkingDir": true,
    "requireUpstream": true
  },
  "github": {
    "release": true,
    "releaseName": "Release v${version}",
    "assets": [],
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": {
    "publish": true,
    "publishPath": ".",
    "access": "public",
    "tokenRef": "NPM_TOKEN"
  },
  "hooks": {
    "before:init": [
      "npm run lint",
      "npm run test"
    ],
    "before:release": [
      "npm run test:coverage"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md"
    }
  }
}